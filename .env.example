# Set a unique 6-12 digit PIN before the first run; don't commit your actual PIN.
# PowerShell example: $env:STAFF_PIN="654321"; npm.cmd run dev
STAFF_PIN=CHANGE_TO_PRIVATE_PIN
# Set to an HTTPS website for public deployment, or http://LAN-IP:5173 during local demo:
PUBLIC_RECEIPT_ORIGIN=http://192.168.1.100:5173
