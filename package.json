{
  "name": "coffee-ordering-kiosk",
  "private": true,
  "version": "4.0.0-phase1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.js",
    "start": "node server/index.js",
    "dev:platform": "node --watch server/main.js",
    "start:platform": "node server/main.js",
    "dev:all": "concurrently -k -n web,v3api,platform \"vite --host 0.0.0.0\" \"node --watch server/index.js\" \"node --watch server/main.js\"",
    "test": "node --test --test-reporter=spec \"server/tests/*.test.js\"",
    "test:watch": "node --test --watch \"server/tests/*.test.js\"",
    "db:inspect": "node server/inspect-db.js",
    "db:backup": "node scripts/backup-databases.js",
    "db:migrate": "node scripts/migrate.js",
    "staff:reset-pin": "node server/reset-pin.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.3.5",
    "@vitejs/plugin-react": "^4.4.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
